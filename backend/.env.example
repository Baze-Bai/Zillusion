# ═══════════════════════════════════════════════════════════════
# DataSource Discovery Agent — Configuration Template
# ═══════════════════════════════════════════════════════════════
# Usage:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in API keys in .env (NEVER in this file!)
#   3. .env is gitignored — safe to put real credentials there
#
# This file contains ONLY default values — NO real credentials.


# ───────────────────────────────────────────
# 1. APPLICATION
# ───────────────────────────────────────────
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000"]
# Optional shared secret. Empty = no API auth (single-user / localhost).
# Set a value to require `X-API-Key: <value>` on all API requests, and
# `?api_key=<value>` on the takeover WebSocket. See SECURITY.md.
APP_API_KEY=


# ───────────────────────────────────────────
# 2. DATABASE
# ───────────────────────────────────────────
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/discovery_agent
DB_POOL_SIZE=20
DB_POOL_OVERFLOW=10


# ───────────────────────────────────────────
# 3. REDIS
# ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0


# ───────────────────────────────────────────
# 4. LLM MODELS & PROVIDER API KEYS
# ───────────────────────────────────────────
#
# Fallback chain: primary → fallback → china
# 每层留空则跳过，至少配一个 strong + 一个 fast
#
# 支持的 model 前缀:
#   Claude:    claude-sonnet-4-20250514 / claude-haiku-4-5-20251001
#   GPT:       gpt-4o / gpt-4o-mini
#   Qwen:      dashscope/qwen-max / dashscope/qwen-turbo / dashscope/qwen-plus
#   GLM:       zai/glm-4.7 / zai/glm-4.5-flash
#   MiniMax:   minimax/MiniMax-M2.5 / minimax/MiniMax-M2.1
#   DeepSeek:  deepseek/deepseek-v4-pro / deepseek/deepseek-v4-flash

# ── Provider API Keys (按需填写，只需填你用的供应商) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=

# ── Reasoning model (单次调用, 最强质量) ──
# 用于: Intent Parser / Router 补充 / Critic 反思 (每阶段只调1次)
LLM_PRIMARY_REASONING=

# ── Strong model (并行调用, 需高并发) ──
# 用于: Stage-B 精评 (10路并发)
LLM_PRIMARY_STRONG=claude-sonnet-4-20250514

# ── Fast model (批量串行, 大吞吐) ──
# 用于: Stage-A 快筛 / TypeClassifier / Portal Detector
LLM_PRIMARY_FAST=claude-haiku-4-5-20251001

# ── Fallback models (第二优先级) ──
LLM_FALLBACK_STRONG=gpt-4o
LLM_FALLBACK_FAST=gpt-4o-mini

# ── China-region models (第三优先级，或中国区设为 Primary) ──
LLM_CHINA_STRONG=
LLM_CHINA_FAST=

# ── Embedding model ──
LLM_EMBEDDING_MODEL=text-embedding-3-small

# ── Provider-specific API base (可选) ──
# DashScope:
# 国际站: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 国内站: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DASHSCOPE_API_BASE=

# Z.AI (GLM/Zhipu):
# 国际站: https://api.z.ai/api/paas/v4/
# 国内站 BigModel: https://open.bigmodel.cn/api/paas/v4/
LLM_ZAI_API_BASE=
# GLM 推理模式: false=速度优先 (3-5x 快), true=质量优先
# 仅影响 glm-4.6+ / glm-5.x; glm-4.5/flash 无推理能力，参数被忽略
LLM_ZAI_THINKING_ENABLED=false

# MiniMax:
LLM_MINIMAX_API_BASE=https://api.minimax.io/v1

# DeepSeek:
# OpenAI 兼容(默认): https://api.deepseek.com   ← litellm deepseek/* 走这条
# Anthropic 兼容:    https://api.deepseek.com/anthropic
LLM_DEEPSEEK_API_BASE=
# DeepSeek V4 推理模式: false=速度优先 (服务端默认开启, 不显式关会慢 3-5 倍),
# true=质量优先. 仅影响 deepseek-v4-pro / deepseek-v4-flash.
LLM_DEEPSEEK_THINKING_ENABLED=false

# ── Token limits (per stage) ──
LLM_MAX_TOKENS_PARSE=4096
LLM_MAX_TOKENS_ROUTE=256
LLM_MAX_TOKENS_CLASSIFY=1024
LLM_MAX_TOKENS_PORTAL_DETECT=512
LLM_MAX_TOKENS_STAGE_A=512
LLM_MAX_TOKENS_STAGE_B=256
LLM_MAX_TOKENS_AUTHORITY=128
LLM_MAX_TOKENS_CRITIC=1024
LLM_MAX_TOKENS_GUIDE=1024

# Generation parameters
LLM_TEMPERATURE=0.1

# ═══════════════════════════════════════════════════════════════
# 4b. PER-SITE LLM PROFILE OVERRIDES
# ═══════════════════════════════════════════════════════════════
# Every LLM call site in the project has a *profile name*. By default each
# profile falls back to its category's tier chain (LLM_PRIMARY_* →
# LLM_FALLBACK_* → LLM_CHINA_*). Set these env vars to OVERRIDE the chain
# for a specific call site — e.g., use Opus for intent parsing while
# keeping everything else on Sonnet.
#
# For each of the 13 registered profiles, five optional env vars are
# available (all leave-empty = fall back to tier chain):
#   LLM_<PROFILE>_PRIMARY      — primary model
#   LLM_<PROFILE>_FALLBACK     — 1st fallback
#   LLM_<PROFILE>_CHINA        — 2nd fallback (china region)
#   LLM_<PROFILE>_TEMPERATURE  — float, overrides LLM_TEMPERATURE
#   LLM_<PROFILE>_MAX_TOKENS   — int, overrides per-stage default
#
# Registered profiles (default tier → call site):
#   intent_parser            (strong) — Stage 1 需求解析
#   judge_stage_b            (strong) — Judge 五维精评
#   reflect                  (strong) — Stage 7 反思补召回
#   source_router            (fast)   — Stage 2 路由补充
#   type_classifier          (fast)   — Stage 3.5 类型判定
#   portal_detector          (fast)   — Portal 识别 LLM 兜底
#   judge_stage_a            (fast)   — Judge 粗筛
#   judge_authority          (fast)   — Authority 评分 LLM 兜底
#   finalize                 (fast)   — Stage 8 使用指南生成
#   embedded_tier2           (fast)   — Embedded Tier-2 内嵌分类
#   embedded_tier3_tree      (fast)   — Embedded Tier-3 DataPageTree 构建
#   embedded_cluster_review  (fast)   — Embedded Step 2.5 聚类审查
#   context_compressor       (fast)   — Context 自动压缩

# ─── Example 1: 让 Intent Parser 单独用 Opus,其他 strong 照旧 ───
# LLM_INTENT_PARSER_PRIMARY=claude-opus-4-20250514
# LLM_INTENT_PARSER_FALLBACK=openai/gpt-5
# LLM_INTENT_PARSER_TEMPERATURE=0.0
# LLM_INTENT_PARSER_MAX_TOKENS=8192

# ─── Example 2: Tier-3 tree builder 走自部署 GLM (比 Haiku 便宜 3x) ───
# LLM_EMBEDDED_TIER3_TREE_PRIMARY=zai/glm-4.5
# LLM_EMBEDDED_TIER3_TREE_FALLBACK=openai/gpt-4o-mini

# ─── Example 3: Judge Stage-A 需要结构化输出稳定,用专用模型 ───
# LLM_JUDGE_STAGE_A_PRIMARY=claude-haiku-4-5-20251001
# LLM_JUDGE_STAGE_A_TEMPERATURE=0.0

# ─── Example 4: Embedded Step 2.5 用便宜模型 (审查任务 LLM 要求不高) ───
# LLM_EMBEDDED_CLUSTER_REVIEW_PRIMARY=zai/glm-4.5
# LLM_EMBEDDED_CLUSTER_REVIEW_MAX_TOKENS=1024

# ─── Example 5: Reflect 用最强推理模型 (反思需要跨阶段综合判断) ───
# LLM_REFLECT_PRIMARY=claude-opus-4-20250514
# LLM_REFLECT_TEMPERATURE=0.3

# Uncomment and customize individual profiles below. Empty = use tier default.
# ── Strong-tier profiles (default: LLM_PRIMARY_STRONG/FALLBACK_STRONG/CHINA_STRONG) ──
LLM_INTENT_PARSER_PRIMARY=
LLM_INTENT_PARSER_FALLBACK=
LLM_INTENT_PARSER_CHINA=
LLM_INTENT_PARSER_TEMPERATURE=
LLM_INTENT_PARSER_MAX_TOKENS=

LLM_JUDGE_STAGE_B_PRIMARY=
LLM_JUDGE_STAGE_B_FALLBACK=
LLM_JUDGE_STAGE_B_CHINA=
LLM_JUDGE_STAGE_B_TEMPERATURE=
LLM_JUDGE_STAGE_B_MAX_TOKENS=

LLM_REFLECT_PRIMARY=
LLM_REFLECT_FALLBACK=
LLM_REFLECT_CHINA=
LLM_REFLECT_TEMPERATURE=
LLM_REFLECT_MAX_TOKENS=

# ── Fast-tier profiles (default: LLM_PRIMARY_FAST/FALLBACK_FAST/CHINA_FAST) ──
LLM_SOURCE_ROUTER_PRIMARY=
LLM_SOURCE_ROUTER_FALLBACK=
LLM_SOURCE_ROUTER_CHINA=
LLM_SOURCE_ROUTER_TEMPERATURE=
LLM_SOURCE_ROUTER_MAX_TOKENS=

LLM_TYPE_CLASSIFIER_PRIMARY=
LLM_TYPE_CLASSIFIER_FALLBACK=
LLM_TYPE_CLASSIFIER_CHINA=
LLM_TYPE_CLASSIFIER_TEMPERATURE=
LLM_TYPE_CLASSIFIER_MAX_TOKENS=

LLM_PORTAL_DETECTOR_PRIMARY=
LLM_PORTAL_DETECTOR_FALLBACK=
LLM_PORTAL_DETECTOR_CHINA=
LLM_PORTAL_DETECTOR_TEMPERATURE=
LLM_PORTAL_DETECTOR_MAX_TOKENS=

LLM_JUDGE_STAGE_A_PRIMARY=
LLM_JUDGE_STAGE_A_FALLBACK=
LLM_JUDGE_STAGE_A_CHINA=
LLM_JUDGE_STAGE_A_TEMPERATURE=
LLM_JUDGE_STAGE_A_MAX_TOKENS=

LLM_JUDGE_AUTHORITY_PRIMARY=
LLM_JUDGE_AUTHORITY_FALLBACK=
LLM_JUDGE_AUTHORITY_CHINA=
LLM_JUDGE_AUTHORITY_TEMPERATURE=
LLM_JUDGE_AUTHORITY_MAX_TOKENS=

LLM_FINALIZE_PRIMARY=
LLM_FINALIZE_FALLBACK=
LLM_FINALIZE_CHINA=
LLM_FINALIZE_TEMPERATURE=
LLM_FINALIZE_MAX_TOKENS=

LLM_EMBEDDED_TIER2_PRIMARY=
LLM_EMBEDDED_TIER2_FALLBACK=
LLM_EMBEDDED_TIER2_CHINA=
LLM_EMBEDDED_TIER2_TEMPERATURE=
LLM_EMBEDDED_TIER2_MAX_TOKENS=

LLM_EMBEDDED_TIER3_TREE_PRIMARY=
LLM_EMBEDDED_TIER3_TREE_FALLBACK=
LLM_EMBEDDED_TIER3_TREE_CHINA=
LLM_EMBEDDED_TIER3_TREE_TEMPERATURE=
LLM_EMBEDDED_TIER3_TREE_MAX_TOKENS=

LLM_EMBEDDED_CLUSTER_REVIEW_PRIMARY=
LLM_EMBEDDED_CLUSTER_REVIEW_FALLBACK=
LLM_EMBEDDED_CLUSTER_REVIEW_CHINA=
LLM_EMBEDDED_CLUSTER_REVIEW_TEMPERATURE=
LLM_EMBEDDED_CLUSTER_REVIEW_MAX_TOKENS=

LLM_CONTEXT_COMPRESSOR_PRIMARY=
LLM_CONTEXT_COMPRESSOR_FALLBACK=
LLM_CONTEXT_COMPRESSOR_CHINA=
LLM_CONTEXT_COMPRESSOR_TEMPERATURE=
LLM_CONTEXT_COMPRESSOR_MAX_TOKENS=


# ───────────────────────────────────────────
# 5. SEARCH ENGINE API KEYS
# ───────────────────────────────────────────
SEARCH_EXA_API_KEY=
SEARCH_BRAVE_API_KEY=
SEARCH_TAVILY_API_KEY=
SEARCH_SEARXNG_URL=http://localhost:8888

# Firecrawl: 自部署 (推荐) 或云端 API
SEARCH_FIRECRAWL_USE_SELF_HOSTED=true
SEARCH_FIRECRAWL_SELF_HOSTED_URL=http://firecrawl:3002
SEARCH_FIRECRAWL_API_KEY=

SEARCH_JINA_API_KEY=

# Search engine defaults
SEARCH_DEFAULT_MAX_RESULTS=10
SEARCH_DEFAULT_TIMEOUT=30

# Exa-specific
SEARCH_EXA_USE_AUTOPROMPT=true
SEARCH_EXA_SEARCH_TYPE=neural

# Tavily-specific
SEARCH_TAVILY_SEARCH_DEPTH=advanced
SEARCH_TAVILY_INCLUDE_RAW_CONTENT=false

# SearXNG-specific
SEARCH_SEARXNG_CATEGORIES=general,science,files


# ───────────────────────────────────────────
# 6. CACHE TTL (seconds)
# ───────────────────────────────────────────
CACHE_L1_SEARCH_TTL=3600
CACHE_L2_PAGE_TTL=21600
CACHE_L3_JUDGING_TTL=86400


# ───────────────────────────────────────────
# 7. BUDGET & PIPELINE LIMITS
# ───────────────────────────────────────────

# Iteration control
BUDGET_MAX_ITERATIONS=3

# Candidate limits
BUDGET_MAX_CANDIDATES_STAGE_A=80
BUDGET_MAX_CANDIDATES_STAGE_B=30
BUDGET_STAGE_A_BATCH_SIZE=10
BUDGET_RELEVANCE_THRESHOLD_STAGE_A=5.0

# Portal limits
BUDGET_MAX_PORTALS_TO_MAP=5
BUDGET_MAX_SCRAPE_PER_PORTAL=15
BUDGET_MAX_TOTAL_SCRAPE=40

# Discovery limits
BUDGET_MAX_KEYWORDS_EN=3
BUDGET_MAX_KEYWORDS_ZH=2
BUDGET_MAX_SUB_QUESTIONS=3

# API validation
BUDGET_QUERY_MIN_LENGTH=5
BUDGET_QUERY_MAX_LENGTH=2000
BUDGET_MAX_ITERATIONS_UPPER_BOUND=5


# ───────────────────────────────────────────
# 8. RATE LIMITING (requests per second)
# ───────────────────────────────────────────
RATE_EXA=5.0
RATE_BRAVE=10.0
RATE_TAVILY=5.0
RATE_SEARXNG=2.0
RATE_FIRECRAWL=3.0
RATE_JINA=10.0
RATE_OPENALEX=10.0
RATE_SEMANTIC_SCHOLAR=5.0
RATE_HUGGINGFACE=5.0
RATE_KAGGLE=2.0
RATE_CKAN=5.0
RATE_WORLDBANK=5.0
RATE_FRED=5.0
RATE_GITHUB=10.0
RATE_APIS_GURU=10.0

# 金融 API (免费版: 5 req/min = 0.08 req/s)
RATE_POLYGON=0.08
RATE_ALPHA_VANTAGE=0.08

# 地球观测
RATE_NASA_EARTHDATA=5.0
RATE_COPERNICUS=5.0

# 生物医学 (无 key: 3 req/s | 有 key: 10 req/s)
RATE_NCBI=3.0

RATE_DEFAULT_SCRAPE=2.0


# ───────────────────────────────────────────
# 9. SCORING WEIGHTS & THRESHOLDS
# ───────────────────────────────────────────

# Dimension weights (must sum to 1.0)
SCORING_WEIGHT_RELEVANCE=0.40
SCORING_WEIGHT_AUTHORITY=0.20
SCORING_WEIGHT_FRESHNESS=0.15
SCORING_WEIGHT_ACCESSIBILITY=0.15
SCORING_WEIGHT_LICENSE_FIT=0.10

# Hard veto
SCORING_VETO_LICENSE_ZERO=true
SCORING_VETO_RELEVANCE_THRESHOLD=4.0

# Accessibility scores (by access level)
SCORING_ACCESS_SCORE_OPEN=10.0
SCORING_ACCESS_SCORE_FREE_REG=8.0
SCORING_ACCESS_SCORE_API_KEY_FREE=7.0
SCORING_ACCESS_SCORE_OAUTH=6.0
SCORING_ACCESS_SCORE_API_KEY_PAID=4.0
SCORING_ACCESS_SCORE_PAYWALL=2.0
SCORING_ACCESS_SCORE_UNKNOWN=3.0

# Freshness half-life (days, by domain)
SCORING_HALFLIFE_NEWS=7
SCORING_HALFLIFE_FINANCE=30
SCORING_HALFLIFE_ECONOMICS=30
SCORING_HALFLIFE_MARKET=30
SCORING_HALFLIFE_TECH=90
SCORING_HALFLIFE_HEALTH=180
SCORING_HALFLIFE_SCIENCE=365
SCORING_HALFLIFE_RESEARCH=365
SCORING_HALFLIFE_GOVERNMENT=365
SCORING_HALFLIFE_GEO=730
SCORING_HALFLIFE_DEFAULT=180

# Freshness unknown date fallback
SCORING_FRESHNESS_UNKNOWN_SCORE=5.0

# Semantic deduplication
SCORING_DEDUP_COSINE_THRESHOLD=0.92

# Authority metadata adjustments — thresholds
SCORING_AUTHORITY_CITATION_HIGH=10000
SCORING_AUTHORITY_CITATION_MEDIUM=1000
SCORING_AUTHORITY_CITATION_LOW=100
SCORING_AUTHORITY_DOWNLOAD_HIGH=100000
SCORING_AUTHORITY_DOWNLOAD_MEDIUM=10000
SCORING_AUTHORITY_STAR_HIGH=10000
SCORING_AUTHORITY_STAR_MEDIUM=1000

# Authority metadata adjustments — scores
SCORING_AUTHORITY_ARCHIVED_PENALTY=-1.5
SCORING_AUTHORITY_ISSUES_PENALTY=-0.5
SCORING_AUTHORITY_ADJUSTMENT_MIN=-2.0
SCORING_AUTHORITY_ADJUSTMENT_MAX=2.0
SCORING_AUTHORITY_GOV_EDU_BONUS=2.0
SCORING_AUTHORITY_ORG_BONUS=0.5

# Authority LLM fallback range
SCORING_AUTHORITY_LLM_FALLBACK_MIN=3.5
SCORING_AUTHORITY_LLM_FALLBACK_MAX=6.5
SCORING_AUTHORITY_UNKNOWN_BASE=5.0


# ───────────────────────────────────────────
# 10. CLASSIFICATION CONFIDENCE LEVELS
# ───────────────────────────────────────────

# TypeClassifier
CLASSIFY_TYPE_URL_PATTERN_CONFIDENCE=0.8
CLASSIFY_TYPE_HEAD_PROBE_CONFIDENCE=0.7
CLASSIFY_TYPE_LLM_CONFIDENCE=0.6
CLASSIFY_TYPE_FALLBACK_CONFIDENCE=0.3
CLASSIFY_TYPE_HEAD_TIMEOUT=5.0

# Portal Detector
CLASSIFY_PORTAL_WHITELIST_CONFIDENCE=1.0
CLASSIFY_PORTAL_URL_PATTERN_CONFIDENCE=0.85
CLASSIFY_PORTAL_SNIPPET_CONFIDENCE=0.75

# Pre-determined sources (registry / portal profiler)
CLASSIFY_PRE_DETERMINED_CONFIDENCE=1.0


# ───────────────────────────────────────────
# 11. CONTEXT COMPRESSION
# ───────────────────────────────────────────
COMPRESS_MAX_CONTEXT_TOKENS=200000
COMPRESS_BUFFER_TOKENS=13000
COMPRESS_WARNING_BUFFER_TOKENS=20000
COMPRESS_MAX_CONSECUTIVE_FAILURES=3
COMPRESS_MICROCOMPACT_KEEP_RECENT=5


# ───────────────────────────────────────────
# 12. ADAPTER DEFAULTS & CREDENTIALS
# ───────────────────────────────────────────

# Global defaults
ADAPTER_DEFAULT_TIMEOUT=30
ADAPTER_DEFAULT_RESULTS_PER_PAGE=15
ADAPTER_DEFAULT_RATE_LIMIT=5.0
ADAPTER_DEFAULT_BURST=10
ADAPTER_HEALTH_CHECK_TIMEOUT=10

# ── OpenAlex (free, no key) ──
# 填入邮箱后自动进入 "polite pool"，速率限制从 10 req/s 提升至 100K req/day
ADAPTER_OPENALEX_EMAIL=

# ── Semantic Scholar (free, key optional) ──
# 无 key: 1 req/s | 有 key: 100 req/s
# 获取: https://www.semanticscholar.org/product/api#api-key
ADAPTER_SEMANTIC_SCHOLAR_API_KEY=

# ── HuggingFace (free, token optional) ──
# 可访问 gated datasets
# 获取: https://huggingface.co/settings/tokens
ADAPTER_HUGGINGFACE_TOKEN=

# ── Kaggle (requires username + key) ──
# 获取: https://www.kaggle.com/settings → API section → Create New API Token
ADAPTER_KAGGLE_USERNAME=
ADAPTER_KAGGLE_KEY=

# ── CKAN portals (free, no key) ──
# 逗号分隔的 CKAN 门户 URL 列表
ADAPTER_CKAN_PORTALS=https://catalog.data.gov,https://data.europa.eu/api/hub/search

# ── FRED (free, requires key) ──
# 获取: https://fredaccount.stlouisfed.org/apikeys
ADAPTER_FRED_API_KEY=

# ── GitHub (free, token optional but recommended) ──
# 无 token: 60 req/hr | 有 token: 5000 req/hr
# 获取: https://github.com/settings/tokens → Generate new token (classic)
ADAPTER_GITHUB_TOKEN=

# ── NASA EarthData (free, requires key) ──
# 获取: https://urs.earthdata.nasa.gov/ → 注册 → Profile → Generate Token
ADAPTER_NASA_EARTHDATA_API_KEY=

# ── Polygon.io (free tier, requires key) ──
# 获取: https://polygon.io/dashboard/signup
ADAPTER_POLYGON_API_KEY=

# ── Alpha Vantage (free tier, requires key) ──
# 获取: https://www.alphavantage.co/support/#api-key
ADAPTER_ALPHA_VANTAGE_API_KEY=

# ── Copernicus (free, requires OAuth client credentials) ──
# 获取: https://dataspace.copernicus.eu/ → Dashboards → OAuth clients → Create
# 用 client_id + client_secret 自动换取 access_token (代码内部自动刷新)
ADAPTER_COPERNICUS_CLIENT_ID=
ADAPTER_COPERNICUS_CLIENT_SECRET=
ADAPTER_COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# ── PubMed/NCBI (free, email recommended) ──
# 有 key: 10 req/s | 无 key: 3 req/s
# 获取: https://www.ncbi.nlm.nih.gov/account/settings/
ADAPTER_NCBI_EMAIL=
ADAPTER_NCBI_API_KEY=

# ── MCP global kill-switch ──
# 设为 1 / true / yes 时跳过所有 MCP 适配器注册（不影响其它适配器）。
# 用于排障、CI 环境无 Node 时屏蔽 npx 子进程，或想暂时关掉 MCP 的场景。
MCP_DISABLED=


# ───────────────────────────────────────────
# 13. COORDINATOR (Multi-Agent)
# ───────────────────────────────────────────
COORD_MAX_CONCURRENT_RESEARCH=3
COORD_MAX_CONCURRENT_IMPLEMENTATION=1


# ───────────────────────────────────────────
# 14. VALIDATION
# ───────────────────────────────────────────
VALIDATE_HEAD_PROBE_TIMEOUT=10.0
VALIDATE_HEAD_PROBE_VERIFY_SSL=false


# ───────────────────────────────────────────
# 15. AUTH
# ───────────────────────────────────────────
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRE_MINUTES=1440
AUTH_API_KEY_PREFIX=dsa_


# ───────────────────────────────────────────
# 16. OBSERVABILITY
# ───────────────────────────────────────────
OBS_LANGSMITH_API_KEY=
OBS_LANGSMITH_PROJECT=datasource-discovery
OBS_LANGFUSE_PUBLIC_KEY=
OBS_LANGFUSE_SECRET_KEY=
OBS_LANGFUSE_HOST=https://cloud.langfuse.com
OBS_ENABLED=true
