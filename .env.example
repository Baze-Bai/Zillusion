# ─────────────────────────────────────────────────────────────
# Root compose-level config.  Copy to `.env`:  cp .env.example .env
#
# Application + LLM + adapter config lives in backend/.env
# (copy from backend/.env.example). This file holds ONLY the knobs that
# docker-compose itself reads.
# ─────────────────────────────────────────────────────────────

# Host bind address for the published ports.
#   127.0.0.1  -> localhost only (DEFAULT, safe for single-user self-hosting)
#   0.0.0.0    -> reachable on your network. Do this ONLY behind your own
#                 auth / reverse proxy. See SECURITY.md.
BIND_HOST=127.0.0.1

# Postgres password used by the compose stack. Change for anything non-local.
POSTGRES_PASSWORD=postgres

# SearXNG secret — REQUIRED (compose will refuse to start if empty).
# Generate one:  openssl rand -hex 32
SEARXNG_SECRET=

# Tag of the prebuilt backend/frontend images used by `docker compose pull`.
#   latest        -> tracks main (DEFAULT)
#   sha-<short>   -> pins one build; the tags are listed on the GHCR package pages
# Irrelevant if you `docker compose up --build` from source.
#ZILLUSION_TAG=latest
